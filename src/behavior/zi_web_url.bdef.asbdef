managed implementation in class zbp_i_web_url unique;
strict ( 2 );
with draft;

define behavior for ZI_WEB_URL alias Website
persistent table zweb_url
draft table zweb_url_d
with additional save
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  action ( features : instance ) OpenWebsite result [1] $self;

  determination setDefaults on modify
  {
    create;
  }

  determination resolveWebsiteUrl on modify
  {
    create;
    field WebsiteName;
  }

  validation validateWebsite on save
  {
    create;
    field WebsiteName, WebsiteUrl;
  }

  validation validateDuplicate on save
  {
    create;
    field WebsiteName;
  }

  field ( readonly, numbering : managed ) WebId;
  field ( mandatory ) WebsiteName;

  field ( readonly )
    WebsiteUrl,
    LaunchCount,
    LastLaunchedAt,
    CreatedBy,
    CreatedAt,
    LastChangedBy,
    LastChangedAt,
    LocalLastChangedAt;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateWebsite;
    validation validateDuplicate;
  }

  mapping for zweb_url
  {
    WebId              = web_id;
    WebsiteName        = website_name;
    WebsiteUrl         = website_url;
    CategoryId         = category_id;
    SearchAliases      = search_aliases;
    Description        = description;
    IsFavorite         = is_favorite;
    IsActive           = is_active;
    LaunchCount        = launch_count;
    LastLaunchedAt     = last_launched_at;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
